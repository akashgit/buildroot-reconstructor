# =============================================================================
# Buildroot Containerfile — auto-generated by buildroot-reconstructor
# Source: {{ source_repo }}
# Tag: {{ git_tag }}
# Generated: {{ timestamp }}
# =============================================================================

# JDK version: {{ jdk_version }} (source: {{ jdk_source }}, confidence: {{ jdk_confidence }})
# Distribution: {{ jdk_distribution }} (source: {{ dist_source }}, confidence: {{ dist_confidence }})
FROM {{ base_image }}

# Build tool: gradle
RUN apt-get update && \
    apt-get install -y --no-install-recommends gradle && \
    rm -rf /var/lib/apt/lists/*

{% if env_vars %}
# Environment variables from CI
{% for key, value in env_vars.items() %}
# env {{ key }}: (source: CI workflow)
ENV {{ key }}={{ value }}
{% endfor %}
{% endif %}
{% if reproducibility_env %}
{% for key, value in reproducibility_env.items() %}
ENV {{ key }}={{ value }}
{% endfor %}
{% endif %}

{% if config_files %}
{% for cf in config_files %}
RUN mkdir -p "$(dirname '{{ cf.path }}')" && cat > '{{ cf.path }}' << 'CONFIGEOF'
{{ cf.content }}
CONFIGEOF
{% endfor %}
{% endif %}

{% if source_repo and git_tag %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch '{{ git_tag }}' '{{ source_repo }}' /build
WORKDIR /build
{% else %}
WORKDIR /build
COPY . .
{% endif %}

{% if pre_build_commands %}
{% for cmd in pre_build_commands %}
RUN {{ cmd }}
{% endfor %}
{% endif %}

# Reproducible build: pin timestamps
ENV SOURCE_DATE_EPOCH=946684800

# Build command: {{ build_command }} (source: {{ build_source }}, confidence: {{ build_confidence }})
RUN {{ build_command }}{% if extra_build_flags %} {{ extra_build_flags | join(' ') }}{% endif %}

{% if post_build_commands %}
{% for cmd in post_build_commands %}
RUN {{ cmd }}
{% endfor %}
{% endif %}

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' \( -path '*/build/libs/*' -o -path '*/build/*' -o -path '*/target/*' -o -path '*/dist/*' \) 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
      tmp=$(mktemp -d) && cd "$tmp" && \
      jar xf "$abs" META-INF/ 2>/dev/null && \
      if [ -f META-INF/MANIFEST.MF ]; then \
        sed -i '/^Built-By:/d;/^Build-Jdk:/d;/^Created-By:/d;/^Bnd-LastModified:/d' META-INF/MANIFEST.MF; \
{% if metadata_strip_patterns %}
{% for pattern in metadata_strip_patterns %}
        sed -i '/{{ pattern }}/d' META-INF/MANIFEST.MF; \
{% endfor %}
{% endif %}
      fi && \
      find META-INF/maven -name pom.properties -exec sed -i '/^#/d' {} \; 2>/dev/null; \
      jar uf "$abs" META-INF/ 2>/dev/null; \
      cd / && rm -rf "$tmp"; \
    done 2>/dev/null || true
