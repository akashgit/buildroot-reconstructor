# =============================================================================
# Buildroot Containerfile — auto-generated by buildroot-reconstructor
# Source: {{ source_repo }}
# Tag: {{ git_tag }}
# Generated: {{ timestamp }}
# =============================================================================

# Base image from CI container reference (source: {{ image_source }}, confidence: {{ image_confidence }})
FROM {{ custom_image }}

{% if maven_version %}
# Maven version: {{ maven_version }} (source: {{ maven_source }}, confidence: {{ maven_confidence }})
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget tar && \
    wget -q https://archive.apache.org/dist/maven/maven-3/{{ maven_version }}/binaries/apache-maven-{{ maven_version }}-bin.tar.gz -O /tmp/maven.tar.gz && \
    tar xzf /tmp/maven.tar.gz -C /opt && \
    ln -s /opt/apache-maven-{{ maven_version }}/bin/mvn /usr/local/bin/mvn && \
    rm /tmp/maven.tar.gz && \
    apt-get purge -y wget && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
ENV MAVEN_HOME=/opt/apache-maven-{{ maven_version }}
RUN mkdir -p /root/.m2 && printf '<settings>\n  <mirrors>\n    <mirror>\n      <id>google-maven-central</id>\n      <mirrorOf>central</mirrorOf>\n      <url>https://maven-central.storage-download.googleapis.com/maven2</url>\n    </mirror>\n  </mirrors>\n</settings>\n' > /root/.m2/settings.xml
{% endif %}

{% if env_vars %}
# Environment variables from CI
{% for key, value in env_vars.items() %}
# env {{ key }}: (source: CI workflow)
ENV {{ key }}={{ value }}
{% endfor %}
{% endif %}
{% if reproducibility_env %}
{% for key, value in reproducibility_env.items() %}
ENV {{ key }}={{ value }}
{% endfor %}
{% endif %}

{% if config_files %}
{% for cf in config_files %}
RUN mkdir -p "$(dirname '{{ cf.path }}')" && cat > '{{ cf.path }}' << 'CONFIGEOF'
{{ cf.content }}
CONFIGEOF
{% endfor %}
{% endif %}

{% if source_repo and git_tag %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch '{{ git_tag }}' '{{ source_repo }}' /build
WORKDIR /build
{% else %}
WORKDIR /build
COPY . .
{% endif %}

{% if pre_build_commands %}
{% for cmd in pre_build_commands %}
RUN {{ cmd }}
{% endfor %}
{% endif %}

# Reproducible build: pin timestamps
ENV SOURCE_DATE_EPOCH=946684800

# Build command: {{ build_command }} (source: {{ build_source }}, confidence: {{ build_confidence }})
RUN {{ build_command }}{% if extra_build_flags %} {{ extra_build_flags | join(' ') }}{% endif %}

{% if post_build_commands %}
{% for cmd in post_build_commands %}
RUN {{ cmd }}
{% endfor %}
{% endif %}

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' -path '*/target/*' 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
      tmp=$(mktemp -d) && cd "$tmp" && \
      jar xf "$abs" META-INF/ 2>/dev/null && \
      if [ -f META-INF/MANIFEST.MF ]; then \
        sed -i '/^Built-By:/d;/^Build-Jdk:/d;/^Created-By:/d;/^Bnd-LastModified:/d' META-INF/MANIFEST.MF; \
{% if metadata_strip_patterns %}
{% for pattern in metadata_strip_patterns %}
        sed -i '/{{ pattern }}/d' META-INF/MANIFEST.MF; \
{% endfor %}
{% endif %}
      fi && \
      find META-INF/maven -name pom.properties -exec sed -i '/^#/d' {} \; 2>/dev/null; \
      jar uf "$abs" META-INF/ 2>/dev/null; \
      cd / && rm -rf "$tmp"; \
    done 2>/dev/null || true
