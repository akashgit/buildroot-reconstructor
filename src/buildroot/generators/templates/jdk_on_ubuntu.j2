# =============================================================================
# Buildroot Containerfile — auto-generated by buildroot-reconstructor
# Source: {{ source_repo }}
# Tag: {{ git_tag }}
# Generated: {{ timestamp }}
# =============================================================================

# Base OS: ubuntu:{{ ubuntu_version }} (source: {{ os_source }}, confidence: {{ os_confidence }})
FROM ubuntu:{{ ubuntu_version }}

ENV DEBIAN_FRONTEND=noninteractive

# System packages (source: CI workflow apt-get steps, confidence: OBSERVED)
{% if system_packages %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
{% for pkg in system_packages %}
    {{ pkg }}{{ " \\" if not loop.last else "" }}
{% endfor %}
    && rm -rf /var/lib/apt/lists/*
{% endif %}

# JDK version: {{ jdk_version }} (source: {{ jdk_source }}, confidence: {{ jdk_confidence }})
# Distribution: {{ jdk_distribution }} (source: {{ dist_source }}, confidence: {{ dist_confidence }})
{% if jdk_distribution == "temurin" %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget apt-transport-https gpg && \
    wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(. /etc/os-release && echo $VERSION_CODENAME) main" > /etc/apt/sources.list.d/adoptium.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends temurin-{{ jdk_version }}-jdk && \
    rm -rf /var/lib/apt/lists/*
{% else %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget && \
    wget -q https://download.java.net/java/GA/jdk{{ jdk_version }}/latest/binaries/openjdk-{{ jdk_version }}_linux-x64_bin.tar.gz -O /tmp/jdk.tar.gz && \
    mkdir -p /usr/lib/jvm && \
    tar xzf /tmp/jdk.tar.gz -C /usr/lib/jvm && \
    rm /tmp/jdk.tar.gz && \
    rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/jdk-{{ jdk_version }}
ENV PATH="${JAVA_HOME}/bin:${PATH}"
{% endif %}

# Build tool: {{ build_tool }}
{% if build_tool == 'ant' %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends ant && \
    rm -rf /var/lib/apt/lists/*
{% elif build_tool == 'gradle' %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends gradle && \
    rm -rf /var/lib/apt/lists/*
{% else %}
# Maven version: {{ maven_version }} (source: {{ maven_source }}, confidence: {{ maven_confidence }})
{% if maven_version %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends wget tar && \
    wget -q https://archive.apache.org/dist/maven/maven-3/{{ maven_version }}/binaries/apache-maven-{{ maven_version }}-bin.tar.gz -O /tmp/maven.tar.gz && \
    tar xzf /tmp/maven.tar.gz -C /opt && \
    ln -s /opt/apache-maven-{{ maven_version }}/bin/mvn /usr/local/bin/mvn && \
    rm /tmp/maven.tar.gz && \
    apt-get purge -y wget && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
ENV MAVEN_HOME=/opt/apache-maven-{{ maven_version }}
{% else %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends maven && \
    rm -rf /var/lib/apt/lists/*
{% endif %}
{% endif %}

{% if env_vars %}
# Environment variables from CI
{% for key, value in env_vars.items() %}
# env {{ key }}: (source: CI workflow)
ENV {{ key }}={{ value }}
{% endfor %}
{% endif %}

{% if source_repo and git_tag %}
RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch '{{ git_tag }}' '{{ source_repo }}' /build
WORKDIR /build
{% else %}
WORKDIR /build
COPY . .
{% endif %}

# Reproducible build: pin timestamps
ENV SOURCE_DATE_EPOCH=0

# Build command: {{ build_command }} (source: {{ build_source }}, confidence: {{ build_confidence }})
RUN {{ build_command }}

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' \( -path '*/target/*' -o -path '*/build/libs/*' -o -path '*/build/*' -o -path '*/dist/*' \) 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
      tmp=$(mktemp -d) && cd "$tmp" && \
      jar xf "$abs" META-INF/ 2>/dev/null && \
      if [ -f META-INF/MANIFEST.MF ]; then \
        sed -i '/^Built-By:/d;/^Build-Jdk:/d;/^Created-By:/d;/^Bnd-LastModified:/d' META-INF/MANIFEST.MF; \
      fi && \
      find META-INF/maven -name pom.properties -exec sed -i '/^#/d' {} \; 2>/dev/null; \
      jar uf "$abs" META-INF/ 2>/dev/null; \
      cd / && rm -rf "$tmp"; \
    done 2>/dev/null || true
