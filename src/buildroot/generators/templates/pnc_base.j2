# =============================================================================
# Buildroot Containerfile — auto-generated by buildroot-reconstructor
# Provenance: PNC (Project Newcastle) build {{ pnc_build_id }}
# Builder image: {{ pnc_builder_image }}
# Source: {{ source_repo }}
# Tag: {{ git_tag }}
# Generated: {{ timestamp }}
# =============================================================================

FROM {{ pnc_builder_image }}

{% if env_vars %}
{% for key, value in env_vars.items() %}
ENV {{ key }}={{ value }}
{% endfor %}
{% endif %}

{% if source_repo and git_tag %}
{% if rhel_version and rhel_version | int >= 8 %}
RUN dnf install -y git && \
    dnf clean all
{% else %}
RUN yum install -y git && \
    yum clean all
{% endif %}
RUN git clone --depth 1 --branch '{{ git_tag }}' '{{ source_repo }}' /build
WORKDIR /build
{% else %}
WORKDIR /build
COPY . .
{% endif %}

# Reproducible build: pin timestamps
ENV SOURCE_DATE_EPOCH=946684800

# Build command: {{ build_command }}
RUN {{ build_command }}{% if extra_build_flags %} {{ extra_build_flags | join(' ') }}{% endif %}

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' \( -path '*/target/*' -o -path '*/build/libs/*' -o -path '*/build/*' -o -path '*/dist/*' \) 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
      tmp=$(mktemp -d) && cd "$tmp" && \
      jar xf "$abs" META-INF/ 2>/dev/null && \
      if [ -f META-INF/MANIFEST.MF ]; then \
        sed -i '/^Built-By:/d;/^Build-Jdk:/d;/^Created-By:/d;/^Bnd-LastModified:/d' META-INF/MANIFEST.MF; \
      fi && \
      find META-INF/maven -name pom.properties -exec sed -i '/^#/d' {} \; 2>/dev/null; \
      jar uf "$abs" META-INF/ 2>/dev/null; \
      cd / && rm -rf "$tmp"; \
    done 2>/dev/null || true
