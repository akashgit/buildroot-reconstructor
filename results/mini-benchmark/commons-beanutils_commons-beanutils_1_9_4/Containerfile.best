FROM docker.io/library/maven:3.9-amazoncorretto-8

# Install git (yum-based, Amazon Linux)
RUN yum install -y git && yum clean all

RUN git clone --depth 1 --branch 'commons-beanutils-1.9.4' 'https://github.com/apache/commons-beanutils' /build
WORKDIR /build

# Reproducible build: pin timestamps
ENV SOURCE_DATE_EPOCH=0

# Verify source checkout
RUN ls /build/pom.xml || (echo 'ERROR: pom.xml missing — source checkout failed' && exit 1)

# Build
RUN mvn clean install -B -DskipTests -Dgpg.skip=true -Drat.skip=true -Dproject.build.outputTimestamp=1

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' \( -path '*/target/*' -o -path '*/build/libs/*' -o -path '*/build/*' -o -path '*/dist/*' \) 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
      tmp=$(mktemp -d) && cd "$tmp" && \
      jar xf "$abs" META-INF/ 2>/dev/null && \
      if [ -f META-INF/MANIFEST.MF ]; then \
        sed -i '/^Built-By:/d;/^Build-Jdk:/d;/^Created-By:/d;/^Bnd-LastModified:/d' META-INF/MANIFEST.MF; \
      fi && \
      find META-INF/maven -name pom.properties -exec sed -i '/^#/d' {} \; 2>/dev/null; \
      jar uf "$abs" META-INF/ 2>/dev/null; \
      cd / && rm -rf "$tmp"; \
    done 2>/dev/null || true