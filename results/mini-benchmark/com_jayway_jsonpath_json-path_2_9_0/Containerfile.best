# JDK version: 17 (source: From setup-java action in CI (actions/setup-java@v3), confidence: OBSERVED)
# Distribution: temurin (source: observed, confidence: OBSERVED)
FROM docker.io/library/eclipse-temurin:17-jdk

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 'json-path-2.9.0' 'https://github.com/json-path/JsonPath' /build
WORKDIR /build

# Reproducible build: pin timestamps
ENV SOURCE_DATE_EPOCH=0

# Build command: use Gradle wrapper (not system gradle); skip test and javadoc
RUN ./gradlew build -x test -x javadoc --no-daemon

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' \( -path '*/build/libs/*' -o -path '*/build/*' -o -path '*/target/*' -o -path '*/dist/*' \) 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
      tmp=$(mktemp -d) && cd "$tmp" && \
      jar xf "$abs" META-INF/ 2>/dev/null && \
      if [ -f META-INF/MANIFEST.MF ]; then \
        sed -i '/^Built-By:/d;/^Build-Jdk:/d;/^Created-By:/d;/^Bnd-LastModified:/d' META-INF/MANIFEST.MF; \
      fi && \
      find META-INF/maven -name pom.properties -exec sed -i '/^#/d' {} \; 2>/dev/null; \
      jar uf "$abs" META-INF/ 2>/dev/null; \
      cd / && rm -rf "$tmp"; \
    done 2>/dev/null || true