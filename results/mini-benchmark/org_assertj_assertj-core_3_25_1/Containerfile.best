RUN ./mvnw $MAVEN_ARGS -f ${{ github.run_id }}.${{ github.base_ref }}/assertj-core/pom.xml package -DskipTests -Dproject.build.outputTimestamp=1980-01-01T00:00:00Z

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' \( -path '*/target/*' -o -path '*/build/libs/*' -o -path '*/build/*' -o -path '*/dist/*' \) 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
