RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch '3.6.1' 'https://github.com/apache/kafka' /build
WORKDIR /build

# Reproducible build: pin timestamps
ENV SOURCE_DATE_EPOCH=0

# Build command: ./gradlew :clients:jar -x test -x integrationTest -x rat -x checkstyleMain -x checkstyleTest -x spotbugsMain -x javadoc --no-daemon --no-scan --no-build-cache -PskipSigning=true -PcommitId=unknown (source: observed, confidence: OBSERVED)
RUN ./gradlew :clients:jar -x test -x integrationTest -x rat -x checkstyleMain -x checkstyleTest -x spotbugsMain -x javadoc --no-daemon --no-scan --no-build-cache -PskipSigning=true -PcommitId=unknown

# Normalize non-reproducible JAR metadata for comparison
RUN for jar in $(find . -name '*.jar' \( -path '*/build/libs/*' -o -path '*/build/*' -o -path '*/target/*' -o -path '*/dist/*' \) 2>/dev/null); do \
      abs=$(readlink -f "$jar") && \
      tmp=$(mktemp -d) && cd "$tmp" && \
      jar xf "$abs" META-INF/ 2>/dev/null && \
      if [ -f META-INF/MANIFEST.MF ]; then \
        sed -i '/^Built-By:/d;/^Build-Jdk:/d;/^Created-By:/d;/^Bnd-LastModified:/d' META-INF/MANIFEST.MF; \
      fi && \
      find META-INF/maven -name pom.properties -exec sed -i '/^#/d' {} \; 2>/dev/null; \
      jar uf "$abs" META-INF/ 2>/dev/null; \
      cd / && rm -rf "$tmp"; \
    done 2>/dev/null || true
