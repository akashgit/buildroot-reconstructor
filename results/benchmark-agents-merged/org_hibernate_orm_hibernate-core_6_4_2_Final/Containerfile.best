FROM eclipse-temurin:25-jdk

# Maven version:  (source: defaulted, confidence: DEFAULTED)
RUN apt-get update && \
    apt-get install -y --no-install-recommends maven && \
    rm -rf /var/lib/apt/lists/*

# Environment variables from CI
# env CURRENT_BRANCH: (source: CI workflow)
ENV CURRENT_BRANCH=${{ github.repository != 'hibernate/hibernate-orm' && 'fork' || github.base_ref || github.ref_name }}
# env DEVELOCITY_ACCESS_KEY: (source: CI workflow)
ENV DEVELOCITY_ACCESS_KEY=${{ secrets.DEVELOCITY_ACCESS_KEY }}
# env GH_TOKEN: (source: CI workflow)
ENV GH_TOKEN=${{ github.token }}
# env GH_EVENT: (source: CI workflow)
ENV GH_EVENT=${{ github.event.workflow_run.event }}
# env FORK_OWNER: (source: CI workflow)
ENV FORK_OWNER=${{ github.event.workflow_run.head_repository.owner.login }}
# env REPO_OWNER: (source: CI workflow)
ENV REPO_OWNER=${{ github.event.workflow_run.repository.owner.login }}
# env REPO_FULL_NAME: (source: CI workflow)
ENV REPO_FULL_NAME=${{ github.event.workflow_run.repository.full_name }}
# env HEAD_BRANCH_NAME: (source: CI workflow)
ENV HEAD_BRANCH_NAME=${{ github.event.workflow_run.head_branch }}
# env GH_PR_ID: (source: CI workflow)
ENV GH_PR_ID=${{steps.determine_branch_ref.outputs.pr_id}}
# env SONAR_TOKEN: (source: CI workflow)
ENV SONAR_TOKEN=${{ secrets.SONAR_TOKEN }}
# env HEAD_BRANCH: (source: CI workflow)
ENV HEAD_BRANCH=${{github.event.workflow_run.head_branch}}
# env STEP_OUTPUT_BRANCH_TO_MERGE: (source: CI workflow)
ENV STEP_OUTPUT_BRANCH_TO_MERGE=${{steps.determine_branch_ref.outputs.branch_to_merge}}
# env STEP_OUTPUT_PR_ID: (source: CI workflow)
ENV STEP_OUTPUT_PR_ID=${{steps.determine_branch_ref.outputs.pr_id}}
# env STEP_OUTPUT_ORIGINAL_BRANCH_REF: (source: CI workflow)
ENV STEP_OUTPUT_ORIGINAL_BRANCH_REF=${{steps.determine_branch_ref.outputs.original_branch_ref}}
# env RDBMS: (source: CI workflow)
ENV RDBMS=${{ matrix.rdbms }}
# env MAVEN_MIRROR: (source: CI workflow)
ENV MAVEN_MIRROR=https://maven-central.storage-download.googleapis.com/maven2/
# env POPULATE_REMOTE_GRADLE_CACHE: (source: CI workflow)
ENV POPULATE_REMOTE_GRADLE_CACHE=${{ github.event_name == 'push' && github.repository == 'hibernate/hibernate-orm' && 'true' || 'false' }}
# env RUNID: (source: CI workflow)
ENV RUNID=${{ github.run_number }}
# env TESTPILOT_CONNECTION_STRING_SUFFIX: (source: CI workflow)
ENV TESTPILOT_CONNECTION_STRING_SUFFIX=${{ steps.create_database.outputs.connection_string_suffix }}
# env TESTPILOT_PASSWORD: (source: CI workflow)
ENV TESTPILOT_PASSWORD=${{ steps.create_database.outputs.database_password }}
# env API_HOST: (source: CI workflow)
ENV API_HOST=
# env TESTPILOT_CLIENT_ID: (source: CI workflow)
ENV TESTPILOT_CLIENT_ID=
# env TESTPILOT_TOKEN: (source: CI workflow)
ENV TESTPILOT_TOKEN=
# env LD_PRELOAD: (source: CI workflow)
ENV LD_PRELOAD=/home/ubuntu/ojdbc_tfo/ojdbc17/23.26.2.0.0/libtfojdbc1.so
# env LD_LIBRARY_PATH: (source: CI workflow)
ENV LD_LIBRARY_PATH=/home/ubuntu/ojdbc_tfo/ojdbc17/23.26.2.0.0
# env GRADLE_OPTS: (source: CI workflow)
ENV GRADLE_OPTS=-Dorg.gradle.workers.max=8
# env ORG_GRADLE_JVMARGS: (source: CI workflow)
ENV ORG_GRADLE_JVMARGS=-Dlog4j2.disableJmx -Xmx4g -XX:MaxMetaspaceSize=256m -XX:+HeapDumpOnOutOfMemoryError -Duser.language=en -Duser.country=US -Duser.timezone=UTC -Dfile.encoding=UTF-8
# env ORG_GRADLE_PROJECT_toolchain.compiler.jvmargs: (source: CI workflow)
ENV ORG_GRADLE_PROJECT_toolchain.compiler.jvmargs=-Dlog4j2.disableJmx=true -Xmx4g -XX:MaxMetaspaceSize=256m -XX:+HeapDumpOnOutOfMemoryError -Duser.language=en -Duser.country=US -Duser.timezone=UTC -Dfile.encoding=UTF-8
# env ORG_GRADLE_PROJECT_toolchain.launcher.jvmargs: (source: CI workflow)
ENV ORG_GRADLE_PROJECT_toolchain.launcher.jvmargs=-Dlog4j2.disableJmx=true -Xmx3g -XX:MaxMetaspaceSize=448m -XX:+HeapDumpOnOutOfMemoryError -Duser.language=en -Duser.country=US -Duser.timezone=UTC -Dfile.encoding=UTF-8

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch '6.4.2' 'https://github.com/hibernate/hibernate-orm' /build
WORKDIR /build/hibernate-core

# Build command: ./gradlew :hibernate-core:jar -x test --no-daemon --no-build-cache (source: observed, confidence: OBSERVED)
RUN ./gradlew :hibernate-core:jar -x test --no-daemon --no-build-cache
