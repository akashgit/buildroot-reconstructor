FROM docker.io/library/eclipse-temurin:17-jdk-jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV CI=true

# System packages (source: CI workflow apt-get steps, confidence: OBSERVED)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    graphviz \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch 'r5.10.1' 'https://github.com/junit-team/junit-framework' /build
WORKDIR /build

# Disable GPG signing via Gradle init script
RUN mkdir -p /root/.gradle/init.d && \
    echo 'allprojects { tasks.withType(Sign) { enabled = false } }' > /root/.gradle/init.d/disable-signing.gradle

# Build command: ./gradlew :junit-jupiter-api:publishToMavenLocal -x test (source: observed, confidence: OBSERVED)
RUN ./gradlew :junit-jupiter-api:publishToMavenLocal -x test