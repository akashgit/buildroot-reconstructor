FROM docker.io/library/eclipse-temurin:11-jdk-focal

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates curl bash && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch 'v1.1.10.5' 'https://github.com/xerial/snappy-java' /build
WORKDIR /build

# Build using SBT (the project's actual build system)
# Use -batch for non-interactive mode, skip tests, and package the jar
RUN chmod +x ./sbt && \
    ./sbt -batch -J-Xmx2g "set Test / skip := true" package publishLocal