# JDK version: 11 (source: CI workflow setup-java, confidence: OBSERVED)
# Distribution: temurin (source: observed, confidence: OBSERVED)
FROM docker.io/library/eclipse-temurin:11-jdk

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Install Maven 3.9.6
ENV MAVEN_VERSION=3.9.6
RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz | tar xzf - -C /opt && \
    ln -s /opt/apache-maven-${MAVEN_VERSION}/bin/mvn /usr/bin/mvn
ENV MAVEN_HOME=/opt/apache-maven-${MAVEN_VERSION}

RUN git clone --depth 1 --branch '2.5.0' 'https://github.com/netplex/json-smart-v2' /build
WORKDIR /build

# Build accessors-smart first (json-smart depends on it)
RUN cd accessors-smart && mvn -B clean install -DskipTests

# Build json-smart
RUN cd json-smart && mvn -B clean install -DskipTests