FROM docker.io/library/eclipse-temurin:8-jdk-jammy

ENV DEBIAN_FRONTEND=noninteractive

# System packages: ant + ivy + git
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ant \
    ant-optional \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch '1.8.0' 'https://github.com/lz4/lz4-java' /build
WORKDIR /build

# Build command: ant ivy-bootstrap && ant init && ant dist-skip-jni (source: observed, confidence: OBSERVED)
RUN ant ivy-bootstrap && ant init && ant dist-skip-jni