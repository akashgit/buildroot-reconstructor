# JDK version: 17 (source: Default (no signal found), confidence: DEFAULTED)
# Distribution: temurin (source: defaulted, confidence: DEFAULTED)
FROM docker.io/library/eclipse-temurin:17-jdk

# Install Ant (Tomcat uses Ant, not Maven)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ant git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch '10.1.18' 'https://github.com/apache/tomcat' /build
WORKDIR /build

# Build command: ant deploy (default target)
RUN ant deploy -Dtest.skip=true