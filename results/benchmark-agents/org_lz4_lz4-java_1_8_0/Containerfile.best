FROM docker.io/library/amazoncorretto:8

RUN yum install -y git tar gzip which curl && yum clean all

RUN curl -fsSL https://archive.apache.org/dist/ant/binaries/apache-ant-1.10.14-bin.tar.gz -o /tmp/ant.tar.gz && \
    tar -xzf /tmp/ant.tar.gz -C /opt && \
    rm /tmp/ant.tar.gz

ENV ANT_HOME=/opt/apache-ant-1.10.14
ENV PATH=/opt/apache-ant-1.10.14/bin:$PATH

RUN git clone --depth 1 --branch '1.8.0' 'https://github.com/lz4/lz4-java' /build
WORKDIR /build

RUN ant ivy-bootstrap

RUN ant dist-skip-jni