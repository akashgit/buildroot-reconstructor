# JDK 8 supports source/target 1.7 and includes javah; Temurin does not provide JDK 7
FROM docker.io/library/eclipse-temurin:8-jdk

ENV DEBIAN_FRONTEND=noninteractive

# Install Ant (this is an Ant/Ivy project; ivy is bootstrapped by the build itself)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ant git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch '1.8.0' 'https://github.com/lz4/lz4-java' /build
WORKDIR /build

# ivy-bootstrap downloads ivy jar to ~/.ant/lib; subsequent ant invocations pick it up
# dist-skip-jni packages everything without native JNI compilation (avoids C toolchain requirement)
RUN ant ivy-bootstrap && ant init && ant dist-skip-jni