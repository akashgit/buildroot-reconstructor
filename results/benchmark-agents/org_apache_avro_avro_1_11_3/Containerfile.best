FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    cmake \
    liblzma-dev \
    libsnappy-dev \
    libjansson-dev \
    zlib1g-dev \
    pkg-config \
    asciidoc \
    source-highlight \
    libsource-highlight-dev \
    gcc \
    g++ \
    libboost-all-dev \
    doxygen \
    wget \
    libzstd-dev \
    libicu-dev \
    subversion \
    cppcheck \
    libbz2-dev \
    git \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends wget apt-transport-https gpg && \
    wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(. /etc/os-release && echo $VERSION_CODENAME) main" > /etc/apt/sources.list.d/adoptium.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends temurin-8-jdk && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends maven && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/temurin-8-jdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

ENV TZ=America/Los_Angeles

RUN git clone --depth 1 --branch 'release-1.11.3' 'https://github.com/apache/avro' /build
WORKDIR /build/lang/java

RUN mvn -B clean install -DskipTests -Dgpg.skip=true -Drat.skip=true -Dmaven.javadoc.skip=true -Dcheckstyle.skip=true