# Buildroot Reconstructor — Environment Configuration
# Copy this file to .env and fill in values for your machine.
#
#   cp .env.example .env
#
# .env is gitignored — it won't be committed. Each machine needs its own copy.
# Values here are defaults that work on lw-preserve (local Postgres).

# ---------------------------------------------------------------------------
# DATABASE_URL — PostgreSQL connection string
# ---------------------------------------------------------------------------
# Used by: build_store.py, scripts/workers/*.sh, scripts/workers/split_gavs.py
#
# On lw-preserve (Postgres runs locally):
#   DATABASE_URL=postgresql:///postgres
#
# On remote workers connecting to Postgres on another machine:
#   DATABASE_URL=postgresql://user:password@db-host/postgres
#
DATABASE_URL=postgresql:///postgres

# ---------------------------------------------------------------------------
# NUM_WORKERS — Number of parallel tmux worker sessions to launch
# ---------------------------------------------------------------------------
# Used by: scripts/workers/launch_workers.sh, scripts/workers/split_gavs.py
#
# Set based on available CPU cores and memory. Each worker runs one
# buildroot agent at a time (podman build + Claude API calls).
# Typical: 30 on lw-preserve (128 cores), 10 on smaller machines.
#
NUM_WORKERS=30

# ---------------------------------------------------------------------------
# GAVS_CSV_PATH — Path to the CSV file listing Maven coordinates to process
# ---------------------------------------------------------------------------
# Used by: scripts/workers/split_gavs.py
#
# The CSV should have a GAV (groupId:artifactId:version) in the last column.
# split_gavs.py reads this, excludes already-processed GAVs, and distributes
# the remainder across NUM_WORKERS worker files.
#
GAVS_CSV_PATH=/workspace/shared/packages_remaining.csv

# ---------------------------------------------------------------------------
# MAVEN_MIRROR_URL — Override the default Maven repository
# ---------------------------------------------------------------------------
# Used by: maven_central.py
#
# Default is Google's Maven Central mirror (no rate limiting).
# repo1.maven.org is used as automatic fallback when the mirror is unavailable.
# Only set this if you need a different mirror.
#
# MAVEN_MIRROR_URL=https://maven-central.storage-download.googleapis.com/maven2
