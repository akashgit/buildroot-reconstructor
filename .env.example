# Buildroot Reconstructor — Environment Configuration
# Copy this file to .env and fill in values for your machine.
#
#   cp .env.example .env
#
# .env is gitignored — it won't be committed. Each machine needs its own copy.
# Values here are defaults that work on lw-preserve (local Postgres).

# ---------------------------------------------------------------------------
# DATABASE_URL — PostgreSQL connection string
# ---------------------------------------------------------------------------
# Used by: build_store.py, run_worker.sh, monitor_workers.sh, split_gavs.py
#
# On lw-preserve (Postgres runs locally):
#   DATABASE_URL=postgresql:///postgres
#
# On remote workers (lw2, lw3, lw4) connecting to Postgres on lw-preserve:
#   DATABASE_URL=postgresql://lab:instructlab@10.241.65.8/postgres
#
DATABASE_URL=postgresql:///postgres

# ---------------------------------------------------------------------------
# DB_PYTHON — Path to the Python binary with buildroot installed
# ---------------------------------------------------------------------------
# Used by: launch_workers.sh (pre-warm), run_worker.sh (DB check),
#          monitor_workers.sh (DB stats)
#
# This should point to the Python in the venv/tool where buildroot is installed.
# Find it with: which python (in your buildroot venv) or: uv tool dir buildroot
#
DB_PYTHON=/home/lab/.local/share/uv/tools/buildroot/bin/python

# ---------------------------------------------------------------------------
# NUM_WORKERS — Number of parallel tmux worker sessions to launch
# ---------------------------------------------------------------------------
# Used by: launch_workers.sh, split_gavs.py
#
# Set based on available CPU cores and memory. Each worker runs one
# buildroot agent at a time (podman build + Claude API calls).
# Typical: 30 on lw-preserve (128 cores), 10 on smaller machines.
#
NUM_WORKERS=30

# ---------------------------------------------------------------------------
# GAVS_CSV_PATH — Path to the CSV file listing Maven coordinates to process
# ---------------------------------------------------------------------------
# Used by: split_gavs.py
#
# The CSV should have a GAV (groupId:artifactId:version) in the last column.
# split_gavs.py reads this, excludes already-processed GAVs, and distributes
# the remainder across NUM_WORKERS worker files.
#
GAVS_CSV_PATH=/workspace/shared/packages_remaining.csv

# ---------------------------------------------------------------------------
# MAVEN_MIRROR_URL — Optional Maven Central mirror (Google Cloud Storage)
# ---------------------------------------------------------------------------
# Used by: maven_central.py (fallback on 429 rate limits)
#
# Leave empty to use repo1.maven.org directly. Set to a GCS mirror URL
# if you hit rate limits during large batch runs.
#
# MAVEN_MIRROR_URL=https://maven-central.storage.googleapis.com/maven2
